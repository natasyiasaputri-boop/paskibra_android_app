<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema utama aplikasi -->
    <style name="Theme.App" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/maroon</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondaryContainer">@color/gold_light</item>
        <item name="android:statusBarColor">@color/maroon_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/bg_light</item>
    </style>

    <!-- Tema splash screen (tampil saat aplikasi dibuka) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/maroon</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>
</resources>
